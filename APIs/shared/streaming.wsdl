<definitions name="StreamingService"
             targetNamespace="http://streaming.com/wsdl"
             xmlns:tns="http://streaming.com/wsdl"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

    <types>
        <xsd:schema targetNamespace="http://streaming.com/wsdl">
            <xsd:complexType name="Usuario">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="nome" type="xsd:string"/>
                    <xsd:element name="idade" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="Musica">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="nome" type="xsd:string"/>
                    <xsd:element name="artista" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="Playlist">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="nome" type="xsd:string"/>
                    <xsd:element name="usuario_id" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- Elementos de Entrada (Devem ser iguais ao nome da operação) -->
            <xsd:element name="ListarUsuarios"><xsd:complexType/></xsd:element>
            <xsd:element name="ListarMusicas"><xsd:complexType/></xsd:element>
            <xsd:element name="ListarPlaylistsPorUsuario">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="ListarMusicasPorPlaylist">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="ListarPlaylistsPorMusica">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>

            <xsd:element name="CriarUsuario">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/><xsd:element name="nome" type="xsd:string"/><xsd:element name="idade" type="xsd:int"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="CriarMusica">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/><xsd:element name="nome" type="xsd:string"/><xsd:element name="artista" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="CriarPlaylist">
                <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/><xsd:element name="nome" type="xsd:string"/><xsd:element name="usuario_id" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="AdicionarMusicaPlaylist">
                <xsd:complexType><xsd:sequence><xsd:element name="playlist_id" type="xsd:string"/><xsd:element name="musica_id" type="xsd:string"/></xsd:sequence></xsd:complexType>
            </xsd:element>

            <!-- Elementos de Saída -->
            <xsd:element name="ListarUsuariosResponse">
                <xsd:complexType><xsd:sequence><xsd:element name="usuarios" type="tns:Usuario" minOccurs="0" maxOccurs="unbounded"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="ListarMusicasResponse">
                <xsd:complexType><xsd:sequence><xsd:element name="musicas" type="tns:Musica" minOccurs="0" maxOccurs="unbounded"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="ListarPlaylistsResponse">
                <xsd:complexType><xsd:sequence><xsd:element name="playlists" type="tns:Playlist" minOccurs="0" maxOccurs="unbounded"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="Usuario" type="tns:Usuario"/>
            <xsd:element name="Musica" type="tns:Musica"/>
            <xsd:element name="Playlist" type="tns:Playlist"/>
        </xsd:schema>
    </types>

    <!-- Messages -->
    <message name="ListarUsuariosReq"><part name="parameters" element="tns:ListarUsuarios"/></message>
    <message name="ListarUsuariosRes"><part name="parameters" element="tns:ListarUsuariosResponse"/></message>
    <message name="ListarMusicasReq"><part name="parameters" element="tns:ListarMusicas"/></message>
    <message name="ListarMusicasRes"><part name="parameters" element="tns:ListarMusicasResponse"/></message>
    
    <message name="ListarPlaylistsPorUsuarioReq"><part name="parameters" element="tns:ListarPlaylistsPorUsuario"/></message>
    <message name="ListarMusicasPorPlaylistReq"><part name="parameters" element="tns:ListarMusicasPorPlaylist"/></message>
    <message name="ListarPlaylistsPorMusicaReq"><part name="parameters" element="tns:ListarPlaylistsPorMusica"/></message>
    <message name="ListaPlaylistsRes"><part name="parameters" element="tns:ListarPlaylistsResponse"/></message>
    <message name="ListaMusicasRes"><part name="parameters" element="tns:ListarMusicasResponse"/></message>

    <message name="CriarUsuarioReq"><part name="parameters" element="tns:CriarUsuario"/></message>
    <message name="CriarUsuarioRes"><part name="parameters" element="tns:Usuario"/></message>
    <message name="CriarMusicaReq"><part name="parameters" element="tns:CriarMusica"/></message>
    <message name="CriarMusicaRes"><part name="parameters" element="tns:Musica"/></message>
    <message name="CriarPlaylistReq"><part name="parameters" element="tns:CriarPlaylist"/></message>
    <message name="CriarPlaylistRes"><part name="parameters" element="tns:Playlist"/></message>
    <message name="AdicionarMusicaPlaylistReq"><part name="parameters" element="tns:AdicionarMusicaPlaylist"/></message>
    <message name="AdicionarMusicaPlaylistRes"><part name="parameters" element="tns:Playlist"/></message>

    <portType name="StreamingPortType">
        <operation name="ListarUsuarios"><input message="tns:ListarUsuariosReq"/><output message="tns:ListarUsuariosRes"/></operation>
        <operation name="ListarMusicas"><input message="tns:ListarMusicasReq"/><output message="tns:ListarMusicasRes"/></operation>
        <operation name="ListarPlaylistsPorUsuario"><input message="tns:ListarPlaylistsPorUsuarioReq"/><output message="tns:ListaPlaylistsRes"/></operation>
        <operation name="ListarMusicasPorPlaylist"><input message="tns:ListarMusicasPorPlaylistReq"/><output message="tns:ListaMusicasRes"/></operation>
        <operation name="ListarPlaylistsPorMusica"><input message="tns:ListarPlaylistsPorMusicaReq"/><output message="tns:ListaPlaylistsRes"/></operation>
        <operation name="CriarUsuario"><input message="tns:CriarUsuarioReq"/><output message="tns:CriarUsuarioRes"/></operation>
        <operation name="CriarMusica"><input message="tns:CriarMusicaReq"/><output message="tns:CriarMusicaRes"/></operation>
        <operation name="CriarPlaylist"><input message="tns:CriarPlaylistReq"/><output message="tns:CriarPlaylistRes"/></operation>
        <operation name="AdicionarMusicaPlaylist"><input message="tns:AdicionarMusicaPlaylistReq"/><output message="tns:AdicionarMusicaPlaylistRes"/></operation>
    </portType>

    <binding name="StreamingBinding" type="tns:StreamingPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="ListarUsuarios"><soap:operation soapAction="ListarUsuarios"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="ListarMusicas"><soap:operation soapAction="ListarMusicas"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="ListarPlaylistsPorUsuario"><soap:operation soapAction="ListarPlaylistsPorUsuario"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="ListarMusicasPorPlaylist"><soap:operation soapAction="ListarMusicasPorPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="ListarPlaylistsPorMusica"><soap:operation soapAction="ListarPlaylistsPorMusica"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="CriarUsuario"><soap:operation soapAction="CriarUsuario"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="CriarMusica"><soap:operation soapAction="CriarMusica"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="CriarPlaylist"><soap:operation soapAction="CriarPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="AdicionarMusicaPlaylist"><soap:operation soapAction="AdicionarMusicaPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    </binding>

    <service name="StreamingService">
        <port name="StreamingPort" binding="tns:StreamingBinding">
            <soap:address location="http://localhost:9004/soap"/>
        </port>
    </service>
</definitions>